rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/owner)
        && request.auth.uid == get(/databases/$(database)/documents/config/owner).data.uid;
    }

    function validMap() {
      return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'nodes', 'frontier'])
        && request.resource.data.keys().hasAll(['schemaVersion', 'revision', 'nodes', 'frontier'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.nodes is map
        && request.resource.data.frontier is list;
    }

    match /maps/public {
      allow get: if true;
      allow list, delete: if false;
      allow create: if isOwner() && validMap() && request.resource.data.revision == 1;
      allow update: if isOwner() && validMap()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
